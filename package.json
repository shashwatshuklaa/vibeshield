{
  "name": "vibeshield",
  "private": true,
  "packageManager": "pnpm@12.23.0",
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:integration": "node scripts/run-mongo-integration.mjs",
    "test:integration:redis": "node scripts/run-redis-integration.mjs",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --if-present run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^15.15.0",
    "prettier": "^3.10.1",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
