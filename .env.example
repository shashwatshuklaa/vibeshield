# ==============================================================================
# VibeShield Platform — Environment Configuration Template
# ==============================================================================
# Copy this file to .env or .env.local for local development.
# NEVER commit .env files containing real secrets, keys, or credentials to Git.
# ==============================================================================

# Core Runtime Configuration
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# API Service Configuration (apps/api)
API_PORT=4000
CORS_ORIGIN=http://localhost:5173

# Frontend Dashboard Configuration (apps/web)
VITE_API_BASE_URL=http://localhost:4000/api

# Database Configuration (apps/api)
MONGODB_URI=mongodb://localhost:27017/vibeshield_dev

# Queue & Cache Configuration (Optional for API; required when QUEUE_ENABLED=true)
QUEUE_ENABLED=false
REDIS_REQUIRED=false
REDIS_URL=redis://localhost:6379
REDIS_CONNECT_TIMEOUT_MS=5000
QUEUE_DEFAULT_ATTEMPTS=3
QUEUE_BACKOFF_DELAY_MS=1000

# Security Worker Configuration (workers/security-worker)
MONGODB_CONNECT_TIMEOUT_MS=10000
WORKER_CONCURRENCY=2
WORKER_LOCK_DURATION=30000
WORKER_STALLED_INTERVAL=30000
WORKER_MAX_STALLED_COUNT=2
WORKER_MAX_STARTED_ATTEMPTS=5
WORKER_LEASE_DURATION_MS=60000
WORKER_SHUTDOWN_GRACE_MS=10000
REDIS_MAX_RECONNECT_ATTEMPTS=10

# Security & Authentication (apps/api)
# Replace with a cryptographically secure random string (minimum 32 characters)
JWT_ACCESS_SECRET=replace_with_a_secure_random_secret_at_least_32_chars
JWT_ACCESS_TTL=15m
JWT_ISSUER=vibeshield-api
JWT_AUDIENCE=vibeshield-clients
AUTH_REFRESH_TOKEN_TTL=7d

# GitHub App Integration (Optional; all core values required together when enabled)
# GITHUB_APP_ID=123456
# GITHUB_APP_SLUG=vibeshield-dev
# GITHUB_APP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# GITHUB_CLIENT_ID=Iv1.exampleclientid
# GITHUB_CLIENT_SECRET=replace_with_github_app_client_secret
# GITHUB_WEBHOOK_SECRET=replace_with_32_plus_char_webhook_secret
# GITHUB_WEBHOOK_SECRET_PREVIOUS=optional_previous_webhook_secret_for_rotation
# GITHUB_CALLBACK_URL=http://localhost:5173/integrations/github/callback

# Internal Worker-to-API Acquisition Listener (apps/api; disabled unless true)
# When INTERNAL_API_ENABLED=true, QUEUE_ENABLED=true and REDIS_URL are required for replay checks.
INTERNAL_API_ENABLED=false
INTERNAL_API_HOST=127.0.0.1
INTERNAL_API_PORT=4001
INTERNAL_WORKER_AUTH_SECRET=replace_with_dedicated_32_plus_char_internal_worker_auth_secret
INTERNAL_AUTH_TIMESTAMP_TOLERANCE_MS=30000
