# ==============================================================================
# VibeShield Platform — Environment Configuration Template
# ==============================================================================
# Copy this file to .env or .env.local for local development.
# NEVER commit .env files containing real secrets, keys, or credentials to Git.
# ==============================================================================

# Core Runtime Configuration
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# API Service Configuration (apps/api)
API_PORT=4000
CORS_ORIGIN=http://localhost:5173

# Frontend Dashboard Configuration (apps/web)
VITE_API_BASE_URL=http://localhost:4000/api

# Database Configuration (Planned)
MONGODB_URI=mongodb://localhost:27017/vibeshield_dev

# Queue & Cache Configuration (Planned)
REDIS_URL=redis://localhost:6379

# Security & Authentication (Planned - placeholders only)
# Replace with a cryptographically secure random string (minimum 32 characters)
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_chars
JWT_EXPIRES_IN=1d
